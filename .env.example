# Salin file ini, isi nilainya, lalu set di Vercel Dashboard
# Settings → Environment Variables

# ── Google Sheets ─────────────────────────────────────────────────────────
# Spreadsheet ID dari URL:
# https://docs.google.com/spreadsheets/d/[INI_SPREADSHEET_ID]/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Email Service Account Google Cloud
# Contoh: my-service@my-project.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=your_service_account_email@your_project.iam.gserviceaccount.com

# Private Key dari file JSON service account
# Salin seluruh isi "private_key" termasuk header dan footer
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"

# ── Admin Panel ───────────────────────────────────────────────────────────
# Username untuk login admin (bebas pilih)
ADMIN_USERNAME=admin

# Password untuk login admin (gunakan yang kuat)
ADMIN_PASSWORD=ganti_dengan_password_kuat

# Secret untuk signing JWT token admin (random string panjang)
# Contoh generate: openssl rand -base64 32
JWT_SECRET=random_secret_string_yang_panjang_dan_kuat
